ENV=production

# Postgres (when running in docker-compose.prod.yml the DB host will be 'db')
DB_HOST=db
DB_PORT=5432
DB_NAME=brickfarm
DB_USER=brickfarm
DB_PASS=brickfarm_pass

# JWT / Auth - replace with a long random secret in production
JWT_SECRET=prod-secret-change-me-in-production-uuid-abc12345xyz
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# S3/MinIO (optional)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_SECURE=false

# Redis (when running in docker-compose.prod.yml the host will be 'redis')
REDIS_URL=redis://redis:6379/0

# CORS - frontend static served from the same host in prod  
CORS_ORIGINS=["http://localhost"]

# Multitenancy
DEFAULT_PLAN=enterprise
